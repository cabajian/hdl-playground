CAPI=2:
name: ::tb_counter_basic:0
description: Basic counter testbench (Verilator)

filesets:
  tb:
    files:
      - tb_counter.sv
    file_type: systemVerilogSource
    depend:
      - "::hdl_playground_rtl:0"

targets:
  sim:
    default_tool: verilator
    filesets: [tb]
    tools:
      verilator:
        mode: binary
        exe: false
        verilator_options:
          - -Wall
          - -Wno-fatal
          - -Wno-UNUSEDSIGNAL
          - -j
          - "0"
    toplevel: tb_counter

  sim_waves:
    default_tool: verilator
    filesets: [tb]
    tools:
      verilator:
        mode: binary
        exe: false
        verilator_options:
          - -Wall
          - -Wno-fatal
          - -Wno-UNUSEDSIGNAL
          - -j
          - "0"
          - --trace
          - +define+WAVES
    toplevel: tb_counter
