# Bootstrap the full toolchain (venv, python deps, Verilator patch, UVM 1.2).
# Idempotent -- re-running is also how you recover the Verilator wheel patch
# after a dependency change.
./scripts/setup_env.sh

source .venv/bin/activate

# Verilator comes from the PyPI wheel rather than the distro package
export VERILATOR_ROOT="$(python3 -c 'import verilator, pathlib; print(pathlib.Path(verilator.__file__).parent)')"
export PATH="$VERILATOR_ROOT/bin:$PATH"

export UVM_HOME="${UVM_HOME:-$HOME/tools/uvm-1.2}"
